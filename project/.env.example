# 复制为 .env 使用；全部可选，缺失时对应功能自动跳过/降级

# 搜索引擎后端 API Key（search.backend 为 serpapi/tavily/bocha 时需要）
SERPAPI_KEY=
TAVILY_KEY=
BOCHA_KEY=

# LLM 补丁抽取（llm.enabled=true 时需要，OpenAI 兼容接口）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# SMTP 邮件通知（notify.smtp.enabled=true 时需要）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=

# 企业微信/飞书 webhook 通知
WEBHOOK_URL=
