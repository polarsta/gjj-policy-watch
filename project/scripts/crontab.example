# gjj-policy-watch crontab 示例（crontab -e 安装前先 cd 到项目目录并确认 python 环境）
# 所有时间均为服务器本地时间，建议服务器时区设为 Asia/Shanghai

# 每日巡检：每天 08:00 执行（官网公告巡检 + 搜索引擎兜底）
0 8 * * *  /path/to/project/scripts/run_daily.sh  >> /path/to/project/reports/cron_daily.log 2>&1

# 周报：每周一 09:00 执行（含 sources 链接抽样健康检查）
0 9 * * 1  /path/to/project/scripts/run_weekly.sh >> /path/to/project/reports/cron_weekly.log 2>&1

# ---------------------------------------------------------------
# 基数调整季加密巡检（每年 6-7 月为各地缴存基数集中调整期）：
# 可在 6-7 月临时改为每日两次，例如追加 20:00 一班，8 月后注释掉：
# 0 8,20 * * *  /path/to/project/scripts/run_daily.sh >> /path/to/project/reports/cron_daily.log 2>&1
# ---------------------------------------------------------------

# 首次部署请先执行一次首日初始化，避免首日海量误报：
#   cd /path/to/project && python -m gjjwatch.cli init-seen
